{
    "dataset": {
        "repo_id": "piper/cube_64_dual",
        "root": "/home/huatec/piper_act_bottle_grasp/data/cube_64_dual",
        "episodes": null,
        "image_transforms": {
            "enable": true,
            "max_num_transforms": 3,
            "random_order": false,
            "tfs": {
                "brightness": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": { "brightness": [0.8, 1.2] }
                },
                "contrast": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": { "contrast": [0.8, 1.2] }
                },
                "saturation": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": { "saturation": [0.5, 1.5] }
                },
                "hue": {
                    "weight": 1.0,
                    "type": "ColorJitter",
                    "kwargs": { "hue": [-0.05, 0.05] }
                },
                "sharpness": {
                    "weight": 1.0,
                    "type": "SharpnessJitter",
                    "kwargs": { "sharpness": [0.5, 1.5] }
                },
                "affine": {
                    "weight": 1.0,
                    "type": "RandomAffine",
                    "kwargs": { "degrees": [-5.0, 5.0], "translate": [0.05, 0.05] }
                }
            }
        },
        "use_imagenet_stats": true,
        "video_backend": "pyav",
        "return_uint8": false,
        "streaming": false
    },
    "policy": {
        "type": "diffusion",
        "n_obs_steps": 2,
        "input_features": {
            "observation.state": { "type": "STATE", "shape": [7] },
            "observation.images.global_rgb": { "type": "VISUAL", "shape": [3, 480, 640] },
            "observation.images.wrist_rgb": { "type": "VISUAL", "shape": [3, 480, 640] }
        },
        "output_features": {
            "action": { "type": "ACTION", "shape": [7] }
        },
        "device": "cuda",
        "use_amp": false,
        "push_to_hub": false,
        "repo_id": null,
        "horizon": 16,
        "n_action_steps": 8,
        "normalization_mapping": {
            "VISUAL": "MEAN_STD",
            "STATE": "MIN_MAX",
            "ACTION": "MIN_MAX"
        },
        "vision_backbone": "resnet18",
        "pretrained_backbone_weights": "ResNet18_Weights.IMAGENET1K_V1",
        "down_dims": [512, 1024, 2048],
        "kernel_size": 5,
        "n_groups": 8,
        "diffusion_step_embed_dim": 128,
        "noise_scheduler_type": "DDPM",
        "num_train_timesteps": 100,
        "num_inference_steps": 100,
        "optimizer_lr": 0.0001,
        "optimizer_weight_decay": 1e-06,
        "scheduler_name": "cosine",
        "scheduler_warmup_steps": 500
    },
    "output_dir": "/home/huatec/piper_diffusion_bottle_grasp-master/outputs/train/cube_64_dual_diffusion",
    "job_name": "cube_64_dual_diffusion",
    "seed": 1000,
    "num_workers": 0,
    "batch_size": 4,
    "prefetch_factor": 4,
    "steps": 20000,
    "log_freq": 100,
    "save_freq": 4000,
    "optimizer": {
        "type": "adamw",
        "lr": 0.0001,
        "weight_decay": 1e-06,
        "grad_clip_norm": 10.0,
        "betas": [0.95, 0.999],
        "eps": 1e-08
    },
    "wandb": { "enable": false }
}
